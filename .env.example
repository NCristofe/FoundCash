# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). A chave "anon" é pública por design; a segurança vem do RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# Opcional: link para agendar a "sessão de ajuda" do onboarding (Calendly, WhatsApp etc.)
VITE_HELP_SESSION_URL=
